<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background_weather_night_block"
    tools:context=".presentation.screens.main.MainFragment">

    <FrameLayout
        android:id="@+id/locationBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0dp"
        android:background="@color/settingsBar"
        app:layout_constraintBottom_toTopOf="@+id/barrierTop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="@+id/locationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.07" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.77" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0dp"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier">

        <com.weatherclothes.artist.presentation.customView.WeatherNightBlock
            android:id="@+id/weatherNightBlock1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0dp"
            android:layout_weight="1"
            app:iconWeather="@drawable/icon_weather_sunny"
            app:temperature="+9°"
            app:timesOfDay="Afternoon" />

        <com.weatherclothes.artist.presentation.customView.WeatherNightBlock
            android:id="@+id/weatherNightBlock2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0dp"
            android:layout_weight="1"
            app:iconWeather="@drawable/icon_weather_sunny"
            app:temperature="+9°"
            app:timesOfDay="Afternoon" />

        <com.weatherclothes.artist.presentation.customView.WeatherNightBlock
            android:id="@+id/weatherNightBlock3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_0dp"
            android:layout_marginBottom="@dimen/margin_bottom"
            android:layout_weight="1"
            app:iconWeather="@drawable/icon_weather_sunny"
            app:temperature="+9°"
            app:timesOfDay="Afternoon" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>