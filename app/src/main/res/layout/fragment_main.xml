<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Theme.WeatherClothes_291024"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.screens.main.MainFragment">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="@dimen/size_0dp"
        android:layout_height="@dimen/size_0dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrierTop" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/error"
        android:layout_width="@dimen/size_0dp"
        android:layout_height="@dimen/size_0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrierTop">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:src="@drawable/image_error_fragment"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_error" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_bold"
            android:text="@string/connection_error"
            android:textColor="@color/textMain"
            android:textSize="@dimen/we_need_your_location"
            app:layout_constraintBottom_toTopOf="@+id/image_error"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.15" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:barrierDirection="top"
            app:constraint_referenced_ids="textExplanationForUser"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="@dimen/vertical_bias_barrier" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textExplanationForUser"
            style="@style/TextSecondaryStyle"
            android:layout_width="@dimen/size_0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/layout_margin_horizontal_text_explanation"
            android:text="@string/text_error_for_user"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/barrier"
            app:layout_constraintVertical_bias="0.2" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tryAgain"
            style="@style/TextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/grant_permission_button"
            android:layout_marginHorizontal="@dimen/layout_margin_horizontal_button"
            android:text="@string/try_again"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textExplanationForUser"
            app:layout_constraintVertical_bias="0.35" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/locationBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0dp"
        android:background="@color/settingsBar"
        app:layout_constraintBottom_toTopOf="@+id/barrierTop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/settingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_start"
        android:paddingEnd="8dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="@+id/locationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="@dimen/size_0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:layout_constraintBottom_toBottomOf="@+id/locationBar"
        app:layout_constraintEnd_toEndOf="@+id/locationBar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/settingsButton"
        app:layout_constraintTop_toTopOf="@+id/locationBar">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            style="@style/TabLayoutStyle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/tabSelectedTextColor"
            app:tabIndicatorHeight="1dp"
            app:tabMode="scrollable"
            app:tabPaddingBottom="@dimen/size_0dp"
            app:tabSelectedTextColor="@color/tabSelectedTextColor"
            app:tabTextColor="@color/tabTextColorWhite" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/vertical_bias_barrier_top_main_fragment" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_layout_height"
        android:background="@color/settingsBar"
        android:translationY="-160dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/settingsClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:src="@drawable/ic_settings_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/degreesTitle"
            style="@style/TextSecondaryStyle.ColorWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/degrees_celsius"
            app:layout_constraintBottom_toTopOf="@+id/degreesFahrenheitTitle"
            app:layout_constraintEnd_toStartOf="@+id/checkMarkDegrees"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/settingsClose" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/checkMarkDegrees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start_degrees"
            android:src="@drawable/ic_check_mark"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/degreesTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/degreesTitle"
            app:layout_constraintTop_toTopOf="@+id/degreesTitle" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/degreesFahrenheitTitle"
            style="@style/TextSecondaryStyle.ColorWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/degrees_fahrenheit"
            app:layout_constraintBottom_toTopOf="@+id/maleTitle"
            app:layout_constraintStart_toStartOf="@+id/degreesTitle"
            app:layout_constraintTop_toBottomOf="@+id/degreesTitle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/checkMarkDegreesFahrenheit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start_degrees"
            android:src="@drawable/ic_check_mark"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/degreesFahrenheitTitle"
            app:layout_constraintStart_toEndOf="@+id/degreesFahrenheitTitle"
            app:layout_constraintTop_toTopOf="@+id/degreesFahrenheitTitle" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/maleTitle"
            style="@style/TextSecondaryStyle.ColorWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/male_character"
            app:layout_constraintBottom_toTopOf="@+id/femaleTitle"
            app:layout_constraintStart_toStartOf="@id/degreesFahrenheitTitle"
            app:layout_constraintTop_toBottomOf="@id/degreesFahrenheitTitle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/checkMarkMale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start_degrees"
            android:src="@drawable/ic_check_mark"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/maleTitle"
            app:layout_constraintStart_toEndOf="@+id/maleTitle"
            app:layout_constraintTop_toTopOf="@+id/maleTitle" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/femaleTitle"
            style="@style/TextSecondaryStyle.ColorWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/settings_margin_bottom"
            android:text="@string/female_character"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/maleTitle"
            app:layout_constraintTop_toBottomOf="@+id/maleTitle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/checkMarkFemale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start_degrees"
            android:src="@drawable/ic_check_mark"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/femaleTitle"
            app:layout_constraintStart_toEndOf="@+id/femaleTitle"
            app:layout_constraintTop_toTopOf="@+id/femaleTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/touchTV"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settings" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/settingsBar"
        android:indeterminateTintMode="src_in"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>