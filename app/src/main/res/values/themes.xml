<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.WeatherClothes_291024" parent="Theme.Material3.DayNight.NoActionBar">
        <!--         <item name="colorPrimary">@android:color/holo_green_dark</item>-->
    </style>

    <style name="Theme.WeatherClothes_291024" parent="Base.Theme.WeatherClothes_291024">
        <item name="android:statusBarColor">@color/statusBar</item>
        <item name="android:navigationBarColor">@color/navigationBar</item>

<!--        <item name="android:windowTranslucentStatus">false</item>-->
<!--        <item name="android:windowTranslucentNavigation">false</item>-->
    </style>

    <style name="LoadTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/ic_load_screen_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
<!--        <item name="enableEdgeToEdge">true</item>-->
    </style>

    <style name="TextSecondaryStyle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">@dimen/bottom_menu</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
    </style>

    <style name="TextSecondaryStyle.ColorWhite" parent="TextSecondaryStyle">
        <item name="android:textColor">@color/tabTextColorWhite</item>
    </style>
    
    <style name="TextSecAccent" parent="Text">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">@dimen/bottom_menu</item>
    </style>

    <style name="TextSecAccent.ColorWhite" parent="TextSecAccent">
        <item name="android:textColor">@color/tabTextColorWhite</item>
    </style>

    <style name="Text">
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textSize">@dimen/weather_night_block</item>
        <item name="android:textColor">@color/textMain</item>
    </style>

    <style name="TextMain" parent="Text">
        <item name="android:textColor">@color/tabTextColorWhite</item>
        <item name="hintTextAppearance">@style/TextMain.Hint</item>
    </style>

    <style name="TextMain.Hint">
        <item name="android:textColorHint">@color/tabTextColorWhite</item>
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textSize">@dimen/hint_text_size</item>
    </style>

    <style name="TextMain.EditText" parent="TextMain.Hint">
        <item name="android:fontFamily">@font/instrument_sans_bold</item>
    </style>

    <style name="TextMainAccentStyle" parent="Text">
        <item name="android:fontFamily">@font/instrument_sans_bold</item>
    </style>

    <style name="TextLoadScreenStyle">
        <item name="fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_load_screen</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextLoadScreenStyle.Bold" parent="TextLoadScreenStyle">
        <item name="fontFamily">@font/instrument_sans_bold</item>
    </style>

    <style name="Text.Temperature" parent="Text">
        <item name="android:textSize">@dimen/temperature</item>
    </style>

    <style name="TabLayoutStyle" parent="Widget.Design.TabLayout">
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textSize">@dimen/text_size_tab_layout</item>
        <item name="android:textStyle">normal</item>
        <item name="textAllCaps">false</item>
        <item name="singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BorderLineStyle">
        <item name="android:background">@color/black</item>
        <item name="android:layout_marginTop">@dimen/layout_margin_top_border</item>
    </style>

    <style name="TextButton" parent="TextMainAccentStyle">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tabTextColorWhite</item>
        <item name="android:background">@drawable/bg_round_button</item>
    </style>
    
    <style name="TextBold">
        <item name="fontFamily">@font/instrument_sans_bold</item>
        <item name="android:textColor">@color/textMain</item>
        <item name="android:textSize">@dimen/we_need_your_location</item>
    </style>

    <style name="Text.H1">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">@dimen/text_h1_size</item>
        <item name="android:textColor">@color/textMain</item>
    </style>
</resources>